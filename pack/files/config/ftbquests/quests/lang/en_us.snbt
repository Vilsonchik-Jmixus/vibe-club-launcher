	quest.1BE84A67C4F49130.title: "&dAmethyst Shards"
	quest.1C709492F2F78BB9.quest_subtitle: "Attach to any inventory to expand its surface area. Great for access in tight spaces and smart setups with threshold switches. - Provides an interface to access two inventories simultaneously. Also comes with filter slots to quickly sort incoming items"
	quest.1C709492F2F78BB9.title: "&aInventory Access Port"
	quest.1C901D6957027EB8.quest_subtitle: "Welcome to Create: Kitchen! It includes three different types of mods designed to help you automate food production, cooking, and farming"
	quest.1C901D6957027EB8.title: "&eWelcome to Create Kitchen"
	quest.1D0911E494CA0184.quest_subtitle: "A &6Mechanical Arm&r is an advanced item distribution machine that works by designating it to specific blocks the arm can reach. If it can't reach a location, the arm won't work. Requires &6SUs&r to operate"
	quest.1D98174DC7159C28.quest_subtitle: "A &cPowered Toggle Latch&r toggles its state with every redstone pulse"
	quest.1DAB0F69BE29D8C5.quest_desc: ["Can also be used to create infinite &9water&r by extracting from a source block that has 2 source blocks adjacent to it"]
	quest.1DAB0F69BE29D8C5.quest_subtitle: "Since most blocks in &6&lCreate&r don't allow for manual extraction and insertion of liquids, these &6Fluid Pipes&r are rather useful"
	quest.1DAB0F69BE29D8C5.title: "Fluid Pipes"
	quest.1E0AB71259E2B4DD.title: "Craft Current Transformer"
	quest.1E3081292571CD31.title: "&cSoothing Hot Chocolate"
	quest.1EA2D92981A22C95.title: "Craft a &6Gasoline Engine&r"
	quest.1EB883EB9A8A3785.title: "Set up a &8Pumpjack&r"
	quest.1EE4A5C43CE2B840.title: "&lEmpty Fan Catalyst"
	quest.1F4456568BDB3EAD.quest_subtitle: "A &6Contraption Control&r let you turn off parts of contraptions while they are formed"
	quest.1FD4C31D8089C49C.title: "Craft Rail Contact and Pantograph"
	quest.1FE8EA6FB9329269.quest_desc: ["The &b&lEcho Shard&r is the first step on the path towards creating the very powerful &5weapons and &5armors&r the Deep Dark&r provides.", "", "&l-&r While usually it's only found in the loot chests inside the &2Ancient City&r after many trials and errors certain &6Master Clerics&r have become able to synthesize it at the comfort of their own brewing stands letting you avoid the many dangers inside of these cities."]
	quest.1FE8EA6FB9329269.title: "&bEcho Shard"
	quest.1FFF9B91CA71694E.quest_subtitle: "Lava applies a small amount of fire damage to entities below in a radius"
	quest.1FFF9B91CA71694E.title: "&cLava Bucket"
	quest.2005366DA716D1AA.quest_desc: ["Easily the longest part of our process the conversion of &6Netherite ingot&r to the &3&lEcho ingot&r needs us to repeat the five step process of ", "", "1&l-&r Pouring &cLava&r over it", "2&l-&r Pressing it", "3&l-&r Pouring some &dMolten Echo&r over it", "4&l-&r Applying a &eBlaze powder&r onto it", "5&l-&r And then pressing it again", "", "&c&nFive times over&r&r", "", "But at the end of this grueling process we will be the owner of a pristine condition &3&lEcho ingot&r"]
	quest.2005366DA716D1AA.title: "&l&9Echo Ingot"
	quest.2005FA370149167D.quest_subtitle: "An &6Item Drain&r allows for the extraction of liquids from items manually or automatically"
	quest.2047D5978329D0AB.title: "Pumpjack"
	quest.20D5607F60F7638A.title: "Craft Electric Motor"
	quest.2165E80C52C79992.quest_desc: ["Press &bR &rwhile hovering over an item to view its Recipe", "", "Press &bU &rwhile hovering over an item to view its Uses", "", "Press &bC &rto Crawl", "", "Press &bM &rto open the World Map", "", "Press &bU &rto Create a New Waypoint", "", "Press &bB &rto open your Backpack", "", "{@pagebreak}"]
	quest.2165E80C52C79992.quest_subtitle: "Read my description! Make sure to scroll down."

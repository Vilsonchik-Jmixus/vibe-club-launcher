	quest.1A9BDF6B88E5A7A9.title: "&aPeat Briquettes "
	quest.1AFEF2789E7179B1.quest_subtitle: "A &6Stressometer&r lets you see the current stress and stress capacity of the kinetic network it's connected to"
	quest.1B3F3097CE12FE41.quest_subtitle: "The thing your trains go on"
	quest.1B3F3097CE12FE41.title: "Train Track"
	quest.1B4EA9D4B62D0237.quest_subtitle: "A &cRedstone Contact&r component that outputs a signal when in contact with another &cRedstone Contact&r. Particularly useful for building contraptions"

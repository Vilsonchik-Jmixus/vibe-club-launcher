	file.0000000000000001.title: " &dVibe Club"
	quest.0013FD56165BCB86.quest_desc: ["You can also switch the look of your &6Water Wheel&r by right-clicking it with pretty much any &awood plank&r (including ones from other mods)"]
	quest.0013FD56165BCB86.quest_subtitle: "A kinetic source that uses the flow of &9water&r as its source of energy. It will generate the same amount of &6SU&r at the same &6RPM&r as long as one block of flowing &9water&r is adjacent"
	quest.002E6872C7B7AF76.title: "&eCandy Cane"
	quest.006C2440BE69D73B.quest_subtitle: "Liquid Fertilizer, a new fluid that applies a bonemeal effect to blocks"
	quest.006C2440BE69D73B.title: "&aLiquid Fertilizer"
	quest.008A7DD4311C72B0.title: "Craft a &6Mechanical Press&r"
	quest.00F10FDD120BC630.quest_desc: ["Simply right click the &6Item Drain&r with a &6Mechanical Grindstone&r and then place another on top of it and you'll be able to grind away the enchantments into &aliquid experience&r."]
	quest.00F10FDD120BC630.quest_subtitle: "Stations to clean your &atools and weapons&r of their enchantments or &epolish some quartz&r"
	quest.00F10FDD120BC630.title: "&8Grindstone and Item Drain"
	quest.012266C464235C7F.title: "Gather Materials"
	quest.0145DD635CA8F16F.quest_subtitle: "Receives the incoming beam and &bpolarizes it&r "
	quest.0145DD635CA8F16F.title: "&dAbsorption Polarizing Filter"
	quest.0148D094A35294EB.quest_subtitle: "You'll need to be either lucky, or have a lot of thorium for this"
	quest.014BDCB9922886EF.title: "&eBar of Caramel"
	quest.01725D55B19D3E0F.quest_subtitle: "These blocks allow you to connect &aCogwheels with chains&r inside complex systems where you don't want some Cogwheels to interact with others"
	quest.01725D55B19D3E0F.title: "&6Flanged Cogwheels"
	quest.01AAA5D33720CE80.quest_subtitle: "The &6Blaze Enchanter&r is a smart enchanting table&r and the &6Blaze Forger&r functions as a smart anvil. "
	quest.01AAA5D33720CE80.title: "&6Craft Blaze Enchanter and Blaze Forger"
	quest.0229FB3DD542C731.quest_subtitle: "A &cRedstone Relay&r only allows &6Energy&r to flow when it is receiving a &credstone&r signal"
	quest.02903C6F107C8DA0.quest_subtitle: "Finally, nuclear"
	quest.02C47B1CE17E8DD5.quest_subtitle: "Hand cranks with a cogwheel installed. Handy for gear ratios and tight spaces"
	quest.02C47B1CE17E8DD5.title: "&6Large Crank Wheel"
	quest.02D5439ACE50EC34.quest_desc: ["Obtained by &cBlasting&r or &cBulk-Blasting&r a piece of Coal Coke"]
	quest.02D5439ACE50EC34.quest_subtitle: "An even better upgrade"
	quest.02D5439ACE50EC34.title: "&7Refined Coal Coke"
	quest.0335A87D46B28982.quest_subtitle: "An item used to craft more advanced mechanical items"
	quest.035F309A9521A315.title: "Obtain a &7Steel Ingot&r"
	quest.0360911A620C6613.title: "&cRose Quartz Catalyst Coil"
	quest.03795968E7FA18BA.quest_desc: ["Place it. &eRight-click&r", "You can now see every shop on the server, price history, trends, and the most active traders", "", "The mod scans the world for &6Table Cloth&r and &6Tradeworks Shelves&r and turns them into a live market interface similar to a stock exchange with the &6Market Terminal&r block"]
	quest.03795968E7FA18BA.quest_subtitle: "&6&lCreate: Stock Market&r turns your server economy into a live, player-driven stock exchange"
	quest.03CD30560CC82ACC.quest_subtitle: "-20% Engine power -75% fuel requirement, for those long haul trips on the cheap"
	quest.03CD30560CC82ACC.title: "&aWater Engine"
	quest.046435AD378CE0C8.quest_subtitle: "Best of the best magnets in store, but extremely expensive"
	quest.04CE5B960FE826CA.quest_subtitle: "When placed in front of the &6Encased Fan&r, a &bSoul Fire&r allows it to haunt items"
	quest.04CEE0CA932DF671.quest_subtitle: "This Create addon adds a variety of items and recipes, introducing new &afuel sources for Blaze Burners&r and giving players unique ways to build Steam Boiler&r setups. Ever wanted a &brenewable alternative to Blaze Cakes&r? Now you have one!"
	quest.04CEE0CA932DF671.title: "&2Blaze Burner Fuels"
	quest.04DA8B82DBFCA3D9.title: "Craft Electric Pump"
	quest.0512ADDB7E6659CA.quest_desc: ["Obtained by compacting some &aCoal&r,&a a Clay Ball &rand&a a piece of Wheat&r with a &6Mechanical Press&r"]
	quest.0512ADDB7E6659CA.quest_subtitle: "To craft Briquettes "
	quest.0512ADDB7E6659CA.title: "&eObtain Materials"
	quest.05352FD080D95A2F.quest_desc: ["You can press &eU&r on the &fStraw&r to see what liquids it accepts, as well as their burn times"]
	quest.05352FD080D95A2F.quest_subtitle: "Ever wanted to pipe liquids into your &6Blaze Burners&r? Just hand them a &fStraw&r and they'll slurp it straight from the pipe!"
	quest.053A085A1D02EEF0.quest_subtitle: "&6Diving Boots&r allow you to walk underwater like you do on land, as well as walk on belts without them moving you around. Be careful when jumping into the ocean, you won't float!"
	quest.05422CBF447A8BB8.quest_desc: ["Obtained by dropping a &6Shaft&r on top of a &6Mechanical Saw&r"]
	quest.05422CBF447A8BB8.quest_subtitle: "An early-game, single-use connector that breaks when the network is overstressed"
	quest.05422CBF447A8BB8.title: "&6Shear Pin"
	quest.056C707476E4BA33.quest_subtitle: "You will require either of these to insert fuel into the inserter"
	quest.056C707476E4BA33.title: "Inserting fuel "
	quest.056C82BE2EB5AA4D.title: "Craft Papers"
	quest.0573A08ED7C44CE6.title: "Setup &8Distillation Tower&r"
	quest.05BC7CBC05B15830.quest_subtitle: "Pushes heat to a small area, be careful to not pump too much heat.."
	quest.05C16E90B3E6304E.quest_desc: ["Needs to rotate at at least &630 RPM&r to function."]
	quest.05C16E90B3E6304E.quest_subtitle: "A &6Mechanical Mixer&r can autocraft shapeless recipes as well as mix things like potions"
	quest.0609D97DEB6E48BF.quest_subtitle: "An &6Encased Chain Drive&r allows for multiple parallel rotational outputs, and to change the axis of the rotational output once"
	quest.06E1BE9BBC046094.quest_subtitle: "&6Mechanical Harvesters&r allow contraptions to harvest crops"
	quest.071F9DA863D5E146.quest_subtitle: "Start by making bread slices with Farmer’s Delight’s cutting board, or craft a burger bun. Place a Sandwich Station, put a bread slice or bun on top, and begin adding ingredients of your choice. Along with food, potions can also be added. When you’re done, break the sandwich to collect it. You can place sandwiches anywhere by shift-right-clicking"
	quest.071F9DA863D5E146.title: "&eMake a &2Chicken Sandwich"
	quest.074A1D3CD1DAA784.title: "Obtain a &6Bronze Ingot&r"
	quest.07EC5E450BA9712D.quest_subtitle: "A &6Depot&r is really just a belt that doesn't move"
	quest.081BC6F954D95C8A.quest_subtitle: "A kinetic source that uses the power of the wind to generate rotational force. The amount of &6SU&r generated depends on the number of sails connected to the &6Windmill&r and maxes out at 8,192 per bearing"
	quest.081BC6F954D95C8A.title: "Windmill Bearing"
	quest.08D5EBEEC4FCBCD2.title: "&eMinecart with Hopper"
	quest.08EA1AEF6AB1C266.quest_subtitle: "It's just a &6Seat&r, nothing more, nothing less. But if you're in a moving contraption, you might as well glue it to the contraption so you can sit and move along with it"
	quest.08EA1AEF6AB1C266.title: "&dSeats"
	quest.0914B65F3F737825.title: "Craft Accumulator"
	quest.092494276E7FD582.title: "&cActivator Rail"
	quest.094A700254F965DE.quest_subtitle: "A &6Encased Fan&r is a very versatile machine that can pull and push entities, as well as wash, haunt, blast, and smoke items"
	quest.095C1249FDE419C7.quest_subtitle: "Melt my heart.."
	quest.095C1249FDE419C7.title: "Uh oh!"
	quest.0AC8942A131FCC34.quest_subtitle: "Condenses up to &athree beams into one&r combining its properties"
	quest.0AC8942A131FCC34.title: "&cBeam Condenser"
	quest.0B75860976DB9B43.quest_subtitle: "A &6Radial Chassis&r is a useful block for building contraptions"
	quest.0BBC18EB21B23D76.title: "Gather Materials and mix them"
	quest.0BCAAE3D64E3FF14.quest_subtitle: "A &6Schedule&r lets you schedule trains so that mobs or &6Blaze Burners&r can drive them"
	quest.0BD86E2C95C59E1B.title: "Craft Ammeter and Voltmetor"
	quest.0C15B829B4F22CF0.quest_desc: ["Obtained by putting through some &cMagma Blocks&r through a pair of &6Crushing Wheels&r"]
	quest.0C15B829B4F22CF0.quest_subtitle: "Perfect fuel for very cheap"
	quest.0C15B829B4F22CF0.title: "&cBlazing Rocks"
	quest.0C59E0866E7EFBF3.quest_subtitle: "A &6Portable Fluid Interface&r allows contraptions to transfer fluids to blocks"
	quest.0CD9F34CBBCA3D44.title: "Obtain Copper Sheets"
	quest.0D49595D9B86A794.quest_desc: ["You will want plenty of &cLava Buckets&r to make sure you never run out of &3superheat fuel&r"]
	quest.0D49595D9B86A794.quest_subtitle: "Tastes like Dr. Pepper"
	quest.0D49595D9B86A794.title: "&aFilling up the tank"
	quest.0D6431E6CC20CCC5.quest_subtitle: "+10% Engine power, for when you need that extra oomph"
	quest.0D6431E6CC20CCC5.title: "&aSturdy Pipes"
	quest.0E4AC2D4FA50A4E2.quest_subtitle: "A Create add-on for crafting custom sandwiches. Compatible with Farmer’s Delight. Build a Sandwich Station to begin"
	quest.0E4AC2D4FA50A4E2.title: "&eCraft the &2Sandwich Station"
	quest.0EB48297625D6051.title: "Obtain Iron Wire Strand"
	quest.0ECF6A73AFA16B0D.quest_subtitle: "&6Cogwheels&r are used to either increase rotational speed or extend contraptions depending on the way they're facing. Play around with the sizes of the cogwheels and see what you can make out of them"

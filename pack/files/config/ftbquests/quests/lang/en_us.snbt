	quest.778CCF75E93579B4.quest_subtitle: "&6Mechanical Belts&r are useful for moving items either in a straight line or diagonally. Make sure to place a &6Shaft&r on each end so they can connect and work properly"
	quest.778CCF75E93579B4.title: "Mechanical Belt"
	quest.7826031A16D82432.quest_subtitle: "A &6Display Board&r is basically an advanced sign that updates faster if provided with higher &6RPM&r. It's like the bulletin boards you see in train stations"
	quest.78446D77D11815AD.title: "Obtain Variac"
	quest.78EA25B85A869DD3.title: "&aZinc Coil"
	quest.7923BEA12687E17D.title: "Craft Connector"
	quest.79AAA8F409A79716.title: "Obtain Iron Ingots"
	quest.7A22F754E879815D.quest_subtitle: "A gearbox where the rotation direction of all 4 sides are independently configurable."
	quest.7A6C4B3AAA08E85B.quest_subtitle: "A &6Track Signal&r is used to control the flow of trains across tracks and track intersections"
	quest.7A6C4B3AAA08E85B.title: "&cTrain Signal"
	quest.7AA109E9271F20A6.title: "Obtain Copper Ingots"
	quest.7B0D85DA0CAD53C8.quest_subtitle: "This addon is all about transferring &aRotational Force&r with the force of &dLight"
	quest.7B0D85DA0CAD53C8.title: "&5Welcome to Optical"
	quest.7B179AAB6FF5DA36.quest_subtitle: "Useful for cutting food or stripping logs."
	quest.7B179AAB6FF5DA36.title: "&eInsert any axe or knife into the &6Slicer"
	quest.7C0C87AECC742AC0.quest_subtitle: "Basically electricity = speed!"
	quest.7C268464F6DE1885.quest_subtitle: "Used in crafting a ton of integral machinery"
	quest.7C268464F6DE1885.title: "&5Optical Device"
	quest.7C26D6CEC3139342.quest_subtitle: "A &6Mechanical Bearing&r allows for contraptions that rotate around a point in space, particularly useful for farms"
	quest.7C490456FC7E561C.quest_subtitle: "The Sprinkler is a block that distributes fluid over a small area below when supplied via a pipe."
	quest.7C490456FC7E561C.title: "&eCraft a &bSprinkler"
	quest.7C50408E8C98AD23.quest_subtitle: "A device that produces immense stress when powered, halting the network by overstressing it."
	quest.7C50408E8C98AD23.title: "&6Brake"
	quest.7D20EAB7E4E34B45.title: "&6Minecart with Chest"
	quest.7D638436555FE784.quest_subtitle: "They can be used for crafting."
	quest.7D638436555FE784.title: "&aObtain &bPrismarine Shards"
	quest.7E583EFD9E9169C5.title: "Craft Swtiches and Power Equipments"
	quest.7FD0E84C5EBA6702.quest_subtitle: "A foundational block for the construction of a reactor."
	reward_table.45675CE5A54BE754.title: "XP"
	reward_table.48DA81CB82402CDB.title: "Early Game Create Pool"
	reward_table.4C51FE85086A8C36.title: "Common Ores"
